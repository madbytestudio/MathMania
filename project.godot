; Engine configuration file.
; MathMania - Game Matematik Darjah 2 (KSSR)
; Projek Godot 4.7

config_version=5

[application]

config/name="MathMania"
config/description="Game matematik interaktif untuk murid Darjah 2 (KSSR)."
config/version="1.0"
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/ui/star_gold.png"

[autoload]

GameState="*res://scripts/game_state.gd"
Sfx="*res://scripts/sfx.gd"
Music="*res://scripts/music.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/custom_font="res://assets/fonts/AlteHaasGroteskBold.ttf"
theme/default_font_size=32

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.68, 0.86, 0.96, 1)
